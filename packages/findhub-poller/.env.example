# Copy to .env and fill in. Never commit the real .env.

# Full gateway webhook URL (canonical bearer form).
LL5_GATEWAY_WEBHOOK_URL=https://gateway.noninoni.click/webhook

# The user's ll5.<...> auth token (identifies which tenant the devices belong to).
LL5_WEBHOOK_TOKEN=ll5.xxxxxxxxxxxxxxxxxxxxxxxx

# Poll cadence. 900s (15 min) respects the network and battery; don't go below ~300s.
FINDHUB_POLL_INTERVAL_SEC=900

# Optional explicit device-type overrides, JSON: {"<canonic_id_or_name>": "tracker"}.
# Types: phone | tablet | watch | tracker | unknown
# FINDHUB_DEVICE_TYPES={"Car Keys":"tracker","Wife's Pixel":"phone"}

LOG_LEVEL=info
