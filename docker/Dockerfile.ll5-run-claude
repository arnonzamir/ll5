# LL5 Claude Code variant agent image.
#
# Build context: ll5 repo root. CI checks out ll5-run-claude-code to
# variant-content/ before docker build. Shared content (CLAUDE.md, skills,
# prompts, mcp-endpoints.json) comes from packages/ll5-run-shared/ in ll5.
#
# Image tag: ghcr.io/arnonzamir/ll5-run-claude:latest
#
# Key design points:
#   - node:20-slim (Debian/glibc) — Claude Code CLI is exercised on glibc
#   - tmux: Claude Code requires a PTY for its TUI
#   - wget: healthcheck probes + render script HTTP checks
#   - HOME=/data/home: persisted via volume — stores onboarding bypass,
#     OAuth token, turn-context, posted-ledger
#   - ll5-server (NOT ll5 launcher): supervisor loop that pre-warms MCPs,
#     gathers opening context, relaunches claude --continue on autoheal kill
#   - No EXPOSE: Claude Code has no HTTP server (process-based healthcheck)
#   - MCP config rendered at build time from shared mcp-endpoints.json

FROM node:20-slim

# Claude Code needs a PTY (tmux) + wget for healthchecks/render. curl is required
# by ll5-server (gateway pings) and jq/git/procps by the agent's helper scripts;
# python3 backs transcribe.py + misc tooling. (These were missing → ll5-server
# error-looped on `curl: command not found` and never launched claude.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      tmux wget curl ca-certificates jq git procps less python3 python3-pip locales \
    && rm -rf /var/lib/apt/lists/*

# UTF-8 locale: the agent lives in Hebrew; a C/POSIX locale garbles tmux + Python
# output. (Ported from the retired ll5-run-claude-code Dockerfile, DECISION-027.)
RUN sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen && locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# On-box (private) voice-note transcription: scripts/transcribe.py uses
# faster-whisper. Install it + pre-download the default 'small' model at build so
# the FIRST voice note doesn't stall on a model download (audio never leaves the
# container). HF_HOME points at an IMAGE path (not the /data/home volume, which
# would shadow a $HOME cache at runtime), and is exported so runtime transcribe.py
# finds the baked-in model. Without this transcribe.py fails "faster-whisper not
# installed" and voice notes go untranscribed.
ENV HF_HOME=/opt/hf-cache
RUN pip3 install --no-cache-dir --break-system-packages faster-whisper openpyxl \
    && python3 -c "from faster_whisper import WhisperModel; WhisperModel('small', device='cpu', compute_type='int8')"

# Claude Code CLI (subscription OAuth, not API key).
#
# PINNED (DECISION-027 / ISS-007). This Dockerfile builds the image that actually
# runs (ghcr.io/arnonzamir/ll5-run-claude); an unpinned `npm install -g` here is
# how the live agent ended up on 2.1.197 while the agent repo "pinned" 2.1.204 in
# a Dockerfile nobody deployed. The pin is a build-arg so the ll5 workflow (and a
# manual dispatch) can bump it deliberately; it is exported as an ENV so the
# entrypoint can assert the installed CLI matches at boot. The npm fetch timeouts
# are from the old agent-repo Dockerfile: @latest installs hung silently on a slow
# CDN (2026-05-11/12), so fail fast instead.
ARG CLAUDE_CODE_VERSION=2.1.204
ENV CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION}
RUN npm config set fetch-timeout 120000 \
 && npm config set fetch-retry-mintimeout 5000 \
 && npm config set fetch-retry-maxtimeout 30000 \
 && npm config set fetch-retries 2 \
 && npm install -g --no-audit --no-fund --no-progress "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

# Build-time tripwire: the installed CLI must be the pinned one. A silent mismatch
# here is exactly the provenance gap this pin exists to close.
RUN INSTALLED="$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)" \
 && echo "[verify] claude --version -> ${INSTALLED} (pin ${CLAUDE_CODE_VERSION})" \
 && test "${INSTALLED}" = "${CLAUDE_CODE_VERSION}"

# tsx for render-mcp-config.ts build step
RUN npm install -g tsx

WORKDIR /workspace

# ---------- Shared content (from ll5 repo) ----------
COPY packages/ll5-run-shared/CLAUDE.md /workspace/CLAUDE.md
COPY packages/ll5-run-shared/skills/ /workspace/.claude/skills/
COPY packages/ll5-run-shared/prompts/ /workspace/prompts/
COPY packages/ll5-run-shared/mcp-endpoints.json /workspace/mcp-endpoints.json

# render-mcp-config.ts (from ll5 repo scripts/)
COPY scripts/render-mcp-config.ts /workspace/scripts/render-mcp-config.ts

# ---------- Variant-specific content (from ll5-run-claude-code repo) ----------
COPY variant-content/.claude/hooks/ /workspace/.claude/hooks/
# The hook WIRING (settings.json `hooks` block) — without this the hook scripts above
# ship but nothing ever invokes them: eval-record, the conversation mirror, memory
# intercept/recall, the narration watchdog and the external-authority gate all go dark.
# The render step below MERGES mcpServers into this file (it used to overwrite it, which
# is exactly how the wiring was lost on 2026-07-13).
COPY variant-content/.claude/settings.json /workspace/.claude/settings.json
COPY variant-content/channel/ /workspace/channel/
# The channel MCP (real-time gateway SSE inbound) needs its deps
# (@modelcontextprotocol/sdk) — without this it fails ERR_MODULE_NOT_FOUND at
# runtime and claude gets no real-time messages (only scheduled batch reviews).
RUN cd /workspace/channel && npm install --omit=dev --no-audit --no-fund
COPY variant-content/scripts/ /workspace/scripts/
COPY variant-content/ll5-server /workspace/ll5-server
# tmux.conf must exist in variant repo; if absent, generate a minimal default
RUN test -f /workspace/tmux.conf || printf 'set -g mouse on\nset -g status off\n' > /workspace/tmux.conf
COPY variant-content/.claude/agents/ /workspace/.claude/agents/
COPY variant-content/.mcp.reconcile.json /workspace/.mcp.reconcile.json
COPY variant-content/.mcp.narrate.json /workspace/.mcp.narrate.json
COPY variant-content/docker-entrypoint.sh /workspace/docker-entrypoint.sh
COPY variant-content/scripts/get-mcp-auth.sh /workspace/scripts/get-mcp-auth.sh

ARG MCP_BASE_DOMAIN

# ---------- Render MCP config from shared source-of-truth ----------
# Reads mcp-endpoints.json, merges mcpServers (with headersHelper → get-mcp-auth.sh, which
# emits Bearer + correlation-id headers) into the variant's settings.json, preserving its
# `hooks` / `permissions` blocks.
RUN npx tsx /workspace/scripts/render-mcp-config.ts \
      --config /workspace/mcp-endpoints.json \
      --format claude \
      --output /workspace/.claude/settings.json

# Build-time tripwire: the image is broken if the render dropped the hook wiring or the
# MCP servers. A silent loss here is invisible until a day of telemetry has gone missing.
RUN node -e 'const s=require("/workspace/.claude/settings.json"); \
  const ev=Object.keys(s.hooks||{}); \
  if(!ev.length) throw new Error("settings.json has no hooks — hook wiring lost"); \
  if(!Object.keys(s.mcpServers||{}).length) throw new Error("settings.json has no mcpServers"); \
  console.error("[verify] hooks wired: "+ev.join(", "))'

# ---------- Persistent $HOME ----------
# Stored on a volume: onboarding bypass (.claude.json), OAuth token
# (~/.ll5/token), turn-context, posted-ledger, claude.log
ENV HOME=/data/home
RUN mkdir -p /data/home/.ll5 /data/home/.claude

# ---------- Permissions ----------
RUN chmod +x /workspace/ll5-server \
             /workspace/docker-entrypoint.sh \
             /workspace/scripts/*.sh \
             /workspace/scripts/get-mcp-auth.sh

# ---------- Healthcheck: process-based (no HTTP server) ----------
# The entrypoint writes /workspace/healthcheck.sh on startup with the
# variant-specific probe. Compose's healthcheck calls it.
# Claude Code: pgrep claude + pgrep ll5-channel (both must be alive)

ENTRYPOINT ["/workspace/docker-entrypoint.sh"]
